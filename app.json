{
  "expo": {
    "name": "AIVES",
    "slug": "aives-mobile",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2563eb",
        "foregroundImage": "./assets/aives-foreground.png",
        "monochromeImage": "./assets/aives-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "vn.aives.mobile.demo",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ]
  }
}
